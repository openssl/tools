"""Rewrite a commit message's reviewer trailers.

Used as `git filter-branch --msg-filter`: the message arrives on stdin
and the rewritten one leaves on stdout.  Usually invoked via `addrev`.
"""

from __future__ import annotations

import sys
from pathlib import Path

# Checked at runtime, not statically: this runs under whatever python3
# the host provides, and the package needs 3.10 for `int | str` aliases.
if sys.version_info < (3, 10):  # noqa: UP036
    sys.exit(
        "gitaddrev needs Python 3.10 or later, found "
        f"{sys.version_info.major}.{sys.version_info.minor}"
    )

# The package lives in lib/ at the top of the tools repository; there is no
# install step, so put it on sys.path.
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from openssl_tools.reviewtools.gitaddrev_cli import main

if __name__ == "__main__":
    sys.exit(main())
