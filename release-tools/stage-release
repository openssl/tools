"""Stage an OpenSSL release.

Run from inside an OpenSSL source worktree.  This lives beside the
`stagerelease` package and is invoked by absolute path, so it puts its own
directory on sys.path rather than requiring an install.
"""
from __future__ import annotations

import sys
from pathlib import Path

if sys.version_info < (3, 10):
    sys.exit(
        "stage-release needs Python 3.10 or later, found "
        f"{sys.version_info.major}.{sys.version_info.minor}"
    )

sys.path.insert(0, str(Path(__file__).resolve().parent))

from stagerelease.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
